# Sao chép file này thành .env.local rồi điền giá trị thật.

# ---------------------------------------------------------------------------
# SUPABASE (bắt buộc)
#   - Supabase Cloud: Project Settings > API
#   - Supabase local (npx supabase start): giá trị in ra ở cuối lệnh
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=thay-bang-anon-key-cua-ban

# ---------------------------------------------------------------------------
# ĐĂNG NHẬP GOOGLE (tuỳ chọn — không có thì vẫn đăng nhập bằng email/mật khẩu)
#
# Lấy ở Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (loại "Web application"). Thêm redirect URI:
#   local : http://127.0.0.1:54321/auth/v1/callback
#   cloud : https://<project-ref>.supabase.co/auth/v1/callback
#
# Hai biến này KHÔNG dùng trực tiếp trong code — chúng nạp vào supabase/config.toml
# (local) hoặc khai ở Supabase Dashboard > Authentication > Providers > Google (cloud).
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# GOOGLE DRIVE PICKER (tuỳ chọn — chỉ cần nếu muốn lấy đề từ Drive)
#
# Cùng project Google Cloud với phần trên:
#   CLIENT_ID : dùng lại OAuth client ID ở trên, nhớ thêm JavaScript origin
#               http://localhost:3000
#   API_KEY   : Credentials > Create credentials > API key.
#               Bật "Google Picker API" và "Google Drive API" trong Library.
#
# Hai biến này lộ ra trình duyệt (tiền tố NEXT_PUBLIC_) — đúng theo thiết kế của
# Google Picker. Hãy giới hạn API key theo HTTP referrer trong Cloud Console.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# ĐỌC FILE WORD BẰNG AI (tuỳ chọn — không có thì chỉ dùng được Excel/CSV)
#
# API key của ChatGPT / OpenRouter / DeepSeek / Claude được nhập TRONG GIAO DIỆN
# tại Quản trị > Cấu hình AI, không khai ở đây. Nhưng để lưu được khoá đó, cần
# một khoá mã hoá — khoá này chỉ nằm trong biến môi trường, không vào database:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ĐỔI khoá này sẽ làm mọi API key đã lưu không giải mã được nữa, phải nhập lại.
# ---------------------------------------------------------------------------
AI_ENCRYPTION_KEY=

# Tuỳ chọn: khai sẵn khoá Claude ở đây thì hệ thống dùng luôn khi chưa cấu hình
# nhà cung cấp nào trong giao diện. Cấu hình trong giao diện sẽ được ưu tiên.
ANTHROPIC_API_KEY=
